{
  "app": {
    "name": "StarterCdpDemo",
    "title": "Starter CDP Demo",
    "version": "1.0.0",
    "mode": "static",
    "entry": "index.html",
    "main": "main.bt"
  },
  "window": {
    "width": 720,
    "height": 520,
    "resizable": true,
    "fullscreen": false,
    "hide_titlebar": false,
    "always_on_top": false
  },
  "dev": {
    "watch": true,
    "delay": 500,
    "devtools": true,
    "console": true
  },
  "resources": [
    "app.json",
    "index.html",
    "main.bt"
  ],
  "exclude": []
}
