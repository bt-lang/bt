{
  "format": "bts",
  "format_version": 1,
  "name": "image",
  "version": "1.0.0",
  "summary": "Bounded RGBA image processing extension",
  "description": "Provides image decoding, creation, resizing, cropping, rotation, watermarking, text, color adjustment, pixel access, and PNG, JPEG, WebP, and BMP encoding.",
  "author": "Lifeng Yan",
  "developer": {
    "id": "bt_official",
    "name": "BT Official",
    "homepage": "https://btlang.org"
  },
  "repository": "https://github.com/bt-lang/bt/tree/main/extension/image",
  "license": "MIT OR Apache-2.0",
  "locales": {
    "zh-CN": {
      "summary": "有界 RGBA 图片处理扩展",
      "description": "提供图片解码、创建、尺寸调整、裁剪、旋转、水印、文本、颜色调整、像素读取以及 PNG、JPEG、WebP、BMP 编码能力。",
      "developer_name": "BT 官方"
    }
  },
  "kind": "wasm",
  "abi": "bts-wasi-1",
  "bt_min_version": "1.1.4",
  "api_version": 1,
  "entry": "module.wasm",
  "bindings": "bindings.json",
  "limits": {
    "max_args_bytes": 16777216,
    "max_result_bytes": 16777216
  },
  "runtime": {
    "mode": "shared",
    "workers": 2,
    "queue_limit": 16,
    "call_timeout_ms": 30000,
    "idle_ttl_ms": 300000,
    "max_objects": 64,
    "max_worker_objects": 32,
    "max_inflight_calls": 4
  }
}
